pipeline {
    agent any

    tools {
        jdk 'jdk-17'       // Nom configuré de votre JDK dans Jenkins
        maven 'mvn-3.6.3'  // Nom configuré de votre Maven dans Jenkins
    }

    environment {
        MAVEN_OPTS = "-Xmx1024m"  // Si vous avez besoin de configurer la mémoire pour Maven
    }

    stages {
        stage('Checkout') {
            steps {
                // Récupérer le code source depuis le dépôt GitHub
                git 'https://github.com/AMENALLAH20/DevSec.git'
            }
        }
        stage('Build and Test') {
            steps {
                script {
                    bat 'mvn clean package'
                }
            }
        }

        stage('OWASP Dependency-Check Vulnerabilities') {
           steps {
             dependencyCheck additionalArguments: ''' 
                    -o './'
                    -s './'
                    -f 'ALL' 
                    --prettyPrint''', odcInstallation: 'OWASP Dependency-Check Vulnerabilities'
        
             dependencyCheckPublisher pattern: 'dependency-check-report.xml'
             }
            }
        stage('SonarQube analysis') {
            steps {
                withSonarQubeEnv(credentialsId: 'sonarqube-secret', installationName: 'sonarqube-server') {
                    withMaven(maven: 'mvn-3.6.3') {
                        // Analyse SonarQube avec les rapports OWASP Dependency-Check
                        sh 'mvn sonar:sonar -Dsonar.dependencyCheck.jsonReportPath=target/dependency-check-report.json ' +
                           '-Dsonar.dependencyCheck.xmlReportPath=target/dependency-check-report.xml ' +
                           '-Dsonar.dependencyCheck.htmlReportPath=target/dependency-check-report.html'
                    }
                }
            }
        }

        // Ajoute d'autres étapes si nécessaire...
    }

    post {
        always {
            // Action après chaque exécution de pipeline (ex: nettoyage)
            cleanWs()  // Nettoyer l'espace de travail
        }
        success {
            // Actions à réaliser si le pipeline réussit
            echo 'Build and tests completed successfully!'
        }
        failure {
            // Actions en cas d'échec
            echo 'Build failed, please check the logs.'
        }
    }
}
