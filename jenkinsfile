pipeline {
    agent any

    tools {
        jdk 'jdk-17'       // Nom configuré de votre JDK dans Jenkins
        maven 'mvn-3.6.3'  // Nom configuré de votre Maven dans Jenkins
    }

    environment {
        MAVEN_OPTS = "-Xmx1024m"  // Si vous avez besoin de configurer la mémoire pour Maven
    }

    stages {
        stage('Checkout') {
            steps {
                // Récupérer le code source depuis le dépôt GitHub
                git 'https://github.com/AMENALLAH20/DevSec.git'
            }
        }
        stage('Build and Test') {
            steps {
                script {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

         stage('OWASP Dependency-Check Vulnerabilities') {
             steps {
               script {
                 // Créer le répertoire de sortie au cas où
                 bat 'mkdir reports\\owasp || echo Directory exists'

                // Exécuter Dependency-Check
                  dependencyCheck additionalArguments: '''
                  -o './reports/owasp'
                  -s './'
                  -f 'ALL'
                  --prettyPrint''', 
                  odcInstallation: 'OWASP Dependency-Check Vulnerabilities'

                   // Vérifier les fichiers générés
                  bat 'dir reports\\owasp /s'

                 // Publier les rapports
                 dependencyCheckPublisher pattern: 'reports/owasp/dependency-check-report.xml'
        }
    }
}          stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('ServerNameSonar') {
                    bat '''mvn clean verify sonar:sonar -Dsonar.projectKey=ProjectNameSonar -Dsonar.projectName='ProjectNameSonar' -Dsonar.host.url=http://localhost:9000''' //port 9000 is default for sonar
                    echo 'SonarQube Analysis Completed'
                }
            }
        }


    }

    post {
        always {
            // Action après chaque exécution de pipeline (ex: nettoyage)
            cleanWs()  // Nettoyer l'espace de travail
        }
        success {
            // Actions à réaliser si le pipeline réussit
            echo 'Build and tests completed successfully!'
        }
        failure {
            // Actions en cas d'échec
            echo 'Build failed, please check the logs.'
        }
    }
}
