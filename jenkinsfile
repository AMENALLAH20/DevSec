pipeline {
    agent any

    tools {
        jdk 'jdk-17'       // Nom configuré de votre JDK dans Jenkins
        maven 'mvn-3.6.3'  // Nom configuré de votre Maven dans Jenkins
    }

    environment {
        MAVEN_OPTS = "-Xmx1024m"  // Si vous avez besoin de configurer la mémoire pour Maven
    }

    stages {
        stage('Checkout') {
            steps {
                // Récupérer le code source depuis le dépôt GitHub
                git 'https://github.com/AMENALLAH20/DevSec.git'
            }
        }
        stage('Build and Test') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }
        stage('OWASP Dependency-Check Vulnerabilities') {
            steps {
                dependencyCheck additionalArguments: '''
                    -o './'           // Enregistrer les rapports dans la racine
                    -s './src'        // Répertoire source à analyser
                    -f 'ALL'          // Générer des rapports dans tous les formats
                ''',
                odcInstallation: 'OWASP Dependency-Check Vulnerabilities'
            }
        }
    }

    post {
        always {
            // Archiver les rapports générés dans la racine
            archiveArtifacts artifacts: 'dependency-check-report.*', fingerprint: true

            // Publier le rapport HTML
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'dependency-check-report.html',
                reportName: 'OWASP Dependency-Check Report'
            ])
        }
    }
}

